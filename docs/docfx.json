{
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "*/*.csproj"
          ]
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "index.md",
          "**/toc.yml",
          "stable-release-policy-v1.md",
          "benchmarks/**/*.md",
          "walkthrough/**/*.md",
          "api/index.md",
          "api/**/*.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**",
          "public/**"
        ]
      }
    ],
    "dest": "_site",
    "sitemap": {
      "baseUrl": "https://asibackbone.github.io/ReferenceApplication/",
      "changefreq": "weekly"
    },
    "template": [
      "default",
      "modern",
      "templates"
    ],
    "globalMetadata": {
      "_lang": "en",
      "_appName": "AsiBackbone Reference Application",
      "_appTitle": "AsiBackbone Reference Application",
      "_appLogoPath": "images/asibackbone-icon-50.png",
      "_appFaviconPath": "images/favicon.ico",
      "_appFooter": "<span>Part of <a href=\"https://asibackbone.github.io/\">AsiBackbone</a> · <a href=\"https://github.com/AsiBackbone/ReferenceApplication\">Source</a> · <a href=\"https://github.com/orgs/AsiBackbone/discussions\">Community</a> · <a href=\"https://github.com/AsiBackbone/ReferenceApplication/blob/main/LICENSE.txt\">License</a> · Made with <a href=\"https://dotnet.github.io/docfx\">DocFX</a></span>",
      "_enableSearch": true,
      "_canonicalBaseUrl": "https://asibackbone.github.io/ReferenceApplication/",
      "_structuredDataSiteName": "AsiBackbone Reference Application",
      "_structuredDataSiteDescription": "API reference and completed implementation record for integrating AsiBackbone into an NCAT-generated host.",
      "_structuredDataPublisherName": "AsiBackbone",
      "_structuredDataPublisherUrl": "https://github.com/AsiBackbone",
      "_socialImageUrl": "https://asibackbone.github.io/ReferenceApplication/images/asibackbone-social.png",
      "_socialImageType": "image/png",
      "_socialImageAlt": "AsiBackbone Reference Application — completed NCAT and AsiBackbone integration walkthrough"
    }
  }
}
