{
  "ConnectionStrings": {
    "DemonstrationDatabase": "Data Source=application-demo.db;Pooling=False",
    "ApplicationSqlServer": "Server=(localdb)\\MSSQLLocalDB;Database=Application;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "AllowedHosts": "*",
  "ReferenceApplication": {
    "DemoIdentity": {
      "Enabled": true
    },
    "GovernanceLoadDemonstration": {
      "Enabled": true,
      "DefaultIterations": 2000,
      "MaximumIterations": 5000,
      "DefaultDurationMilliseconds": 5000,
      "MaximumDurationMilliseconds": 10000,
      "ProgressIntervalMilliseconds": 100
    },
    "PolicySimulator": {
      "Enabled": true
    },
    "DecisionReplay": {
      "Enabled": true
    },
    "FailureScenarios": {
      "Enabled": true
    },
    "PipelineInspector": {
      "Enabled": true
    },
    "AuditReconciliation": {
      "Interval": "00:01:00"
    },
    "CapabilityTokens": {
      "Enabled": false,
      "Issuer": "referenceapplication",
      "Audience": "referenceapplication.governed-operations",
      "KeyId": "referenceapplication-capability-token",
      "KeyVersion": "1",
      "LifetimeSeconds": 120,
      "AllowedClockSkewSeconds": 0,
      "UseStorePurgeIntervalSeconds": 300
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Debug",
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File",
      "Serilog.Enrichers.Environment",
      "Serilog.Enrichers.Thread"
    ],
    "WriteTo": [
      {
        "Name": "Debug",
        "Args": {
          "minimumLevel": "Debug",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] [CorrelationId: {CorrelationId}] [TraceId: {TraceId}] [SpanId: {SpanId}] [RequestId: {RequestId}] [RequestPath: {RequestPath}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "Console",
        "Args": {
          "theme": "Serilog.Sinks.SystemConsole.Themes.AnsiConsoleTheme::Code, Serilog.Sinks.Console",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] [CorrelationId: {CorrelationId}] [TraceId: {TraceId}] [SpanId: {SpanId}] [RequestId: {RequestId}] [RequestPath: {RequestPath}] {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "minimumLevel": "Debug",
          "path": "Logs/application-web-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 5,
          "fileSizeLimitBytes": 10485760,
          "rollOnFileSizeLimit": true,
          "shared": true,
          "flushToDiskInterval": "00:00:01",
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} {Level:u3}] [{SourceContext}] [CorrelationId: {CorrelationId}] [TraceId: {TraceId}] [SpanId: {SpanId}] [RequestId: {RequestId}] [RequestPath: {RequestPath}] {Message:lj}{NewLine}{Exception}"
        }
      }
    ]
  }
}
