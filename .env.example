# Copy this file to .env for local Docker Compose overrides.
# Do not commit .env files containing local secrets or machine-specific values.

ASPNETCORE_ENVIRONMENT=Development
CONNECTIONSTRINGS_APPLICATIONDATABASE=Data Source=/app/data/application-dev.db
CONNECTIONSTRINGS_DEMONSTRATIONDATABASE=Data Source=/app/data/application-demo.db;Pooling=False

# Development only. Set to false to serve ApplicationDatabase instead of the disposable demonstration database.
REFERENCEAPPLICATION_DEMOIDENTITY_ENABLED=true

REFERENCEAPPLICATION_FORWARDEDHEADERS_ENABLED=true
REFERENCEAPPLICATION_FORWARDEDHEADERS_FORWARDLIMIT=1
REFERENCEAPPLICATION_FORWARDEDHEADERS_REQUIREHEADERSYMMETRY=false

# Local Docker development only.
# Production deployments should configure explicit KnownProxies or KnownNetworks.
REFERENCEAPPLICATION_FORWARDEDHEADERS_CLEARKNOWNNETWORKSANDPROXIES=true
