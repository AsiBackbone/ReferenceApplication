@model ReferenceApplication.Web.Models.GovernanceExplorerViewModel

@{
    ViewData["Title"] = "Governance Explorer";
    ViewData["BodyClass"] = "governance-explorer-page";
    bool showTabs = Model.ShowDemoIdentityControls || Model.ShowGovernanceLoadDemonstration || Model.ShowPolicySimulator ||
        Model.ShowDecisionReplay || Model.ShowPipelineInspector || Model.ShowFailureScenarios;
}

@section Styles {
    <link rel="stylesheet" href="~/css/governance-explorer.css" asp-append-version="true" />
}

<header class="explorer-heading">
    <p class="eyebrow">Live accountability walkthrough</p>
    <h1>Governance Explorer</h1>
    <p>
        Run the real governed endpoints and watch their persisted decision, mutation, outbox, and lifecycle evidence
        arrive. Signed in as <strong>@Model.ActorDisplayName</strong>.
    </p>
    <a class="secondary-link" href="/">Back to application home</a>
</header>

<div class="explorer-grid"
     data-can-view-evidence="@Model.CanViewEvidence.ToString().ToLowerInvariant()"
     data-database-reset="@Model.DemonstrationDatabaseWasReset.ToString().ToLowerInvariant()"
     data-load-demonstration="@Model.ShowGovernanceLoadDemonstration.ToString().ToLowerInvariant()"
     data-policy-simulator="@Model.ShowPolicySimulator.ToString().ToLowerInvariant()"
     data-decision-replay="@Model.ShowDecisionReplay.ToString().ToLowerInvariant()"
     data-pipeline-inspector="@Model.ShowPipelineInspector.ToString().ToLowerInvariant()"
     data-failure-scenarios="@Model.ShowFailureScenarios.ToString().ToLowerInvariant()">
    <section class="explorer-panel controls-panel" aria-label="Explorer controls">
        @if (showTabs)
        {
            <div class="explorer-tabs" role="tablist" aria-label="Explorer sections">
                <button id="explorer-tab-actions" class="explorer-tab" type="button" role="tab" aria-selected="true"
                        aria-controls="explorer-panel-actions" data-output="evidence">
                    Actions
                </button>
                @if (Model.ShowDemoIdentityControls)
                {
                    <button id="explorer-tab-identity" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-identity" tabindex="-1" data-output="evidence">
                        Demo identity
                    </button>
                }
                @if (Model.ShowGovernanceLoadDemonstration)
                {
                    <button id="explorer-tab-load" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-load" tabindex="-1" data-output="load">
                        Load demonstration
                    </button>
                }
                @if (Model.ShowPolicySimulator)
                {
                    <button id="explorer-tab-simulator" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-simulator" tabindex="-1" data-output="simulator">
                        Policy simulator
                    </button>
                }
                @if (Model.ShowDecisionReplay)
                {
                    <button id="explorer-tab-replay" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-replay" tabindex="-1" data-output="replay">
                        Decision replay
                    </button>
                }
                @if (Model.ShowPipelineInspector)
                {
                    <button id="explorer-tab-pipeline" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-pipeline" tabindex="-1" data-output="pipeline">
                        Pipeline inspector
                    </button>
                }
                @if (Model.ShowFailureScenarios)
                {
                    <button id="explorer-tab-scenarios" class="explorer-tab" type="button" role="tab" aria-selected="false"
                            aria-controls="explorer-panel-scenarios" tabindex="-1" data-output="scenarios">
                        Failure scenarios
                    </button>
                }
            </div>
        }

        <div id="explorer-panel-actions" class="explorer-tab-panel" role="@(showTabs ? "tabpanel" : null)"
             aria-labelledby="@(showTabs ? "explorer-tab-actions" : null)">
            <h2 id="explorer-actions-heading">Actions</h2>
            <p>Each button calls the production endpoint with the page's antiforgery token.</p>

            <form id="governance-actions" class="governance-actions">
                @Html.AntiForgeryToken()
                <button type="button" data-governed-action="administrator">Run administrator action</button>
                <button type="button" data-governed-action="capability">Run capability action</button>

                <div class="acknowledgment-control">
                    <div class="toggle-row">
                        <input id="explorer-acknowledgment" type="checkbox" />
                        <label for="explorer-acknowledgment">Acknowledge the consequential-action prompt</label>
                    </div>
                    <p>
                        This enables the demonstration request. The endpoint still returns its host-owned acknowledgment
                        challenge; this checkbox is not authorization and does not bypass governance.
                    </p>
                </div>
                <button type="button" data-governed-action="consequential" data-requires-acknowledgment="true">
                    Request consequential action
                </button>

                <label for="explorer-record-title">Sample record title</label>
                <input id="explorer-record-title" name="Title" maxlength="160" value="Governance explorer record" />
                <button type="button" data-governed-action="records" data-includes-title="true">Create audited record</button>
            </form>

            <div id="explorer-status" class="explorer-status" role="status" aria-live="polite">
                @if (Model.DemonstrationDatabaseWasReset)
                {
                    <text>Demonstration database reset. The migrated evidence state is empty.</text>
                }
                else
                {
                    <text>Ready to run a governed action.</text>
                }
            </div>
        </div>

        @if (Model.ShowDemoIdentityControls)
        {
            <div id="explorer-panel-identity" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-identity" hidden>
                <h2>Demo identity</h2>
                <p>
                    Development only. The fixed claims you apply here are the ones the Actions, Load demonstration, and
                    Policy simulator tabs run as.
                </p>
                <form class="identity-controls" method="post" action="/Account/DemoSignIn">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="/governance-explorer" />
                    <fieldset>
                        <legend>Development demo actor</legend>
                        <p>Apply a fixed claim combination, then run an action to compare outcomes.</p>
                        <div class="toggle-row">
                            <input id="explorer-administrator" type="checkbox" name="administrator" value="true"
                                   checked="@Model.HasAdministratorRole" />
                            <label for="explorer-administrator">Administrator role</label>
                        </div>
                        <div class="toggle-row">
                            <input id="explorer-capability" type="checkbox" name="consequentialCapability" value="true"
                                   checked="@Model.HasConsequentialCapability" />
                            <label for="explorer-capability">Consequential capability grant</label>
                        </div>
                        <button class="secondary-button" type="submit">Apply demo identity</button>
                    </fieldset>
                </form>

                @if (Model.HasAdministratorRole)
                {
                    <form class="demo-database-reset" method="post" action="/governance-explorer/reset-database">
                        @Html.AntiForgeryToken()
                        <p>
                            The explorer uses a disposable Development-only SQLite database. Reset it to remove all demo
                            records and evidence, then reapply the migrations.
                        </p>
                        <button class="secondary-button" type="submit">Reset demonstration database</button>
                    </form>
                }
            </div>
        }

        @if (Model.ShowGovernanceLoadDemonstration)
        {
            <div id="explorer-panel-load" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-load" hidden>
                <p class="demonstration-label">Demonstration, not a benchmark</p>
                <h2 id="load-demonstration-heading">Bounded live governance load</h2>
                <p>
                    Evaluate the production governance policy composition in-process and watch transient aggregate
                    throughput and latency. This run makes no HTTP self-requests and persists no synthetic evidence.
                    Use the <a href="https://asibackbone.github.io/ReferenceApplication/benchmarks/governance-overhead.html">published benchmarks</a>
                    for repeatable measurements.
                </p>
                <form id="load-demonstration-form">
                    @Html.AntiForgeryToken()
                    <label for="load-demonstration-iterations">Decisions</label>
                    <input id="load-demonstration-iterations" name="iterations" type="number" min="1"
                           max="@Model.LoadDemonstrationMaximumIterations"
                           value="@Model.LoadDemonstrationDefaultIterations" />
                    <label for="load-demonstration-duration">Duration limit (milliseconds)</label>
                    <input id="load-demonstration-duration" name="durationMilliseconds" type="number" min="1"
                           max="@Model.LoadDemonstrationMaximumDurationMilliseconds"
                           value="@Model.LoadDemonstrationDefaultDurationMilliseconds" />
                    <div class="load-demonstration-buttons">
                        <button id="start-load-demonstration" type="submit">Start bounded run</button>
                        <button id="cancel-load-demonstration" class="secondary-button" type="button" disabled>Cancel</button>
                    </div>
                </form>
                <div id="load-demonstration-status" class="load-demonstration-status" role="status" aria-live="polite">
                    No demonstration has run in this application process.
                </div>
            </div>
        }

        @if (Model.ShowPolicySimulator)
        {
            <div id="explorer-panel-simulator" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-simulator" hidden>
                <p class="demonstration-label">Simulation, nothing is persisted</p>
                <h2 id="policy-simulator-heading">Policy simulator</h2>
                <p>
                    Build a request and watch how its decision is made: each constraint, the decision policy, the
                    capability grant check, and the receipt that would be appended. The simulator runs the production
                    governance pipeline in-process, without calling the governed endpoint, and writes no evidence.
                </p>
                <form id="policy-simulator-form">
                    @Html.AntiForgeryToken()
                    <label for="policy-simulator-operation">Governed operation</label>
                    <select id="policy-simulator-operation" name="operation">
                        <option value="administrator">Administrator action</option>
                        <option value="capability">Capability action</option>
                        <option value="consequential">Consequential action</option>
                        <option value="records">Create audited record</option>
                    </select>

                    <fieldset>
                        <legend>Simulated actor</legend>
                        <p>Fixed options only, as with the demo identity. The actor identifier is yours.</p>
                        <div class="toggle-row">
                            <input id="policy-simulator-administrator" type="checkbox" name="administrator" value="true"
                                   checked="@Model.HasAdministratorRole" />
                            <label for="policy-simulator-administrator">Administrator role</label>
                        </div>
                        <div class="toggle-row">
                            <input id="policy-simulator-capability" type="checkbox" name="consequentialCapability"
                                   value="true" checked="@Model.HasConsequentialCapability" />
                            <label for="policy-simulator-capability">Consequential capability grant</label>
                        </div>
                    </fieldset>

                    <div class="toggle-row">
                        <input id="policy-simulator-acknowledged" type="checkbox" name="acknowledged" value="true" />
                        <label for="policy-simulator-acknowledged">Acknowledge the consequential-action prompt</label>
                    </div>

                    <label for="policy-simulator-payload">Sample payload</label>
                    <input id="policy-simulator-payload" name="payload" maxlength="160"
                           value="Governance explorer record" />

                    <fieldset>
                        <legend>Constraints</legend>
                        <p>Clear a constraint to see what it contributes. The result is then marked as simulated with a modified policy.</p>
                        @for (int index = 0; index < Model.PolicySimulatorConstraintNames.Count; index++)
                        {
                            string constraintName = Model.PolicySimulatorConstraintNames[index];
                            <div class="toggle-row">
                                <input id="policy-simulator-constraint-@index" type="checkbox" checked
                                       data-constraint-name="@constraintName" />
                                <label for="policy-simulator-constraint-@index">@constraintName</label>
                            </div>
                        }
                    </fieldset>

                    <p class="policy-simulator-model">
                        Capability grants: @(Model.CapabilityTokensEnabled ? "signed tokens" : "permission claims").
                    </p>

                    <div class="policy-simulator-buttons">
                        <button id="evaluate-policy-simulation" type="submit">Evaluate</button>
                        <button id="send-policy-simulation" class="secondary-button" type="button" disabled>
                            Send for real
                        </button>
                    </div>
                </form>
                <div id="policy-simulator-status" class="load-demonstration-status" role="status" aria-live="polite">
                    No simulation has run yet.
                </div>
            </div>
        }

        @if (Model.ShowDecisionReplay)
        {
            <div id="explorer-panel-replay" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-replay" hidden>
                <p class="demonstration-label">Replay, nothing is persisted</p>
                <h2 id="decision-replay-heading">Decision replay</h2>
                <p>
                    Open a past decision by its receipt identifier, or pick one of the recent decisions, then replay it
                    against the current policy and, if you like, a what-if candidate. Replay reads the ledger and never
                    writes to it.
                </p>
                <form id="decision-replay-lookup" class="decision-replay-lookup">
                    <label for="decision-replay-receipt">Decision receipt identifier</label>
                    <input id="decision-replay-receipt" name="decisionReceiptId" maxlength="128" autocomplete="off"
                           spellcheck="false" />
                    <div class="decision-replay-buttons">
                        <button id="find-decision" type="submit">Find decision</button>
                    </div>
                </form>

                <div class="decision-replay-recent-heading">
                    <h3 id="decision-replay-recent-heading">Recent decisions</h3>
                    <button id="decision-replay-refresh" class="secondary-button" type="button">Newest</button>
                </div>
                <ol id="decision-replay-recent" class="decision-replay-recent" aria-labelledby="decision-replay-recent-heading"
                    aria-busy="false">
                    <li class="output-note">The newest decisions load when this tab opens.</li>
                </ol>
                <button id="decision-replay-older" class="secondary-button" type="button" hidden>Load older</button>

                <form id="decision-replay-form">
                    @Html.AntiForgeryToken()
                    <fieldset>
                        <legend>Candidate policy (what-if)</legend>
                        <p>
                            Every replay runs against the current policy. Choose a candidate as well to see what a policy
                            change would have done to this decision.
                        </p>
                        <div class="toggle-row">
                            <input id="decision-replay-candidate" type="checkbox" name="candidatePolicy" value="true" />
                            <label for="decision-replay-candidate">
                                Stand-in policy @ReferenceApplication.Web.Governance.Replay.CandidateGovernancePolicySet.Version
                            </label>
                        </div>
                        <ul class="candidate-policy-changes">
                            @foreach (string change in ReferenceApplication.Web.Governance.Replay.CandidateGovernancePolicySet.Changes)
                            {
                                <li>@change</li>
                            }
                        </ul>
                        <p>Constraints in the candidate. Clear one to leave it out.</p>
                        @for (int index = 0; index < Model.DecisionReplayConstraintNames.Count; index++)
                        {
                            string constraintName = Model.DecisionReplayConstraintNames[index];
                            <div class="toggle-row">
                                <input id="decision-replay-constraint-@index" type="checkbox" checked
                                       data-constraint-name="@constraintName" />
                                <label for="decision-replay-constraint-@index">@constraintName</label>
                            </div>
                        }
                    </fieldset>
                    <div class="decision-replay-buttons">
                        <button id="replay-decision" type="submit" disabled>Replay selected decision</button>
                    </div>
                </form>
                <div id="decision-replay-status" class="load-demonstration-status" role="status" aria-live="polite">
                    No decision selected.
                </div>
            </div>
        }

        @if (Model.ShowPipelineInspector)
        {
            <div id="explorer-panel-pipeline" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-pipeline" hidden>
                <p class="demonstration-label">Demonstration, not a benchmark</p>
                <h2 id="pipeline-inspector-heading">Pipeline inspector</h2>
                <p>
                    Follow a governed request through the pipeline. Policy evaluation and the decision-receipt append run on
                    the request path. A mutation stages its audit completion in the same transaction, and the outbox worker
                    delivers it later, appending the lifecycle event. The times shown come from timestamps the pipeline
                    already records; the
                    <a href="https://asibackbone.github.io/ReferenceApplication/benchmarks/governance-overhead.html">published benchmarks</a>
                    measure what each stage costs.
                </p>
                <form id="pipeline-inspector-form">
                    <label for="pipeline-correlation">Request correlation identifier</label>
                    <input id="pipeline-correlation" name="correlationId" maxlength="128" autocomplete="off"
                           spellcheck="false" />
                    <div class="toggle-row">
                        <input id="pipeline-follow" type="checkbox" checked />
                        <label for="pipeline-follow">Follow the latest governed action</label>
                    </div>

                    <label for="pipeline-outbox-status">Outbox entries</label>
                    <select id="pipeline-outbox-status" name="status">
                        <option value="">All statuses</option>
                        @foreach (string status in Model.PipelineOutboxStatuses)
                        {
                            <option value="@status">@status</option>
                        }
                    </select>

                    <div class="toggle-row">
                        <input id="pipeline-live" type="checkbox" checked />
                        <label for="pipeline-live">Refresh every 2 seconds while this tab is open</label>
                    </div>
                    <div class="pipeline-inspector-buttons">
                        <button id="refresh-pipeline" type="submit">Refresh now</button>
                    </div>
                </form>
                <div id="pipeline-inspector-status" class="load-demonstration-status" role="status" aria-live="polite">
                    The pipeline is read when this tab opens.
                </div>
            </div>
        }

        @if (Model.ShowFailureScenarios)
        {
            <div id="explorer-panel-scenarios" class="explorer-tab-panel" role="tabpanel"
                 aria-labelledby="explorer-tab-scenarios" hidden>
                <h2 id="failure-scenarios-heading">Failure scenarios</h2>
                <p>
                    Trigger a failure or attack path against the real governed endpoints, then inspect what was blocked and
                    what evidence was left behind. Each run is armed for one request: its fault applies only to that
                    request and disarms once it is used. The evidence lands in the disposable demonstration database, which
                    the Demo identity tab can reset.
                </p>
                <ol class="failure-scenario-list">
                    @foreach (var scenario in Model.FailureScenarios)
                    {
                        <li class="failure-scenario" data-scenario-id="@scenario.Id">
                            <h3>@scenario.Number. @scenario.Title</h3>
                            <p>@scenario.Teaches</p>
                            <p class="failure-scenario-expectation"><strong>Expect:</strong> @scenario.Expectation</p>
                            @if (scenario.Available)
                            {
                                <button type="button" data-run-scenario="@scenario.Id">Run scenario @scenario.Number</button>
                            }
                            else
                            {
                                <p class="failure-scenario-unavailable" role="note">@scenario.UnavailableReason</p>
                                <button type="button" disabled>Run scenario @scenario.Number</button>
                            }
                        </li>
                    }
                </ol>
                <div id="failure-scenario-status" class="load-demonstration-status" role="status" aria-live="polite">
                    Choose a scenario to run.
                </div>
            </div>
        }
    </section>

    <section class="explorer-panel output-panel" aria-label="Explorer output">
        <div id="explorer-output-evidence" class="explorer-output" data-output-view="evidence">
            <div class="evidence-heading-row">
                <div>
                    <h2 id="explorer-evidence-heading">Evidence</h2>
                    <p id="explorer-correlation">No request selected.</p>
                </div>
                <button id="verify-evidence" class="secondary-button" type="button" disabled>Verify hashes</button>
            </div>

            @if (!Model.CanViewEvidence)
            {
                <div class="authorization-note" role="note">
                    The current actor can run authenticated demonstrations, but the full ledger requires an administrator
                    role. Apply the Development demo administrator role or sign in through an authorized provider.
                </div>
            }

            <div id="verification-result" class="verification-result" aria-live="polite"></div>
            <ol id="evidence-timeline" class="evidence-timeline" aria-live="polite" aria-busy="false">
                <li class="empty-evidence">Run an action to populate its evidence timeline.</li>
            </ol>
        </div>

        @if (Model.ShowGovernanceLoadDemonstration)
        {
            <div id="explorer-output-load" class="explorer-output" data-output-view="load" hidden>
                <h2>Live load metrics</h2>
                <p class="output-note">Transient, process-local demonstration feedback; not benchmark results.</p>
                <dl class="load-demonstration-metrics">
                    <dt>Progress</dt>
                    <dd id="load-demonstration-progress">0 / 0</dd>
                    <dt>Elapsed</dt>
                    <dd id="load-demonstration-elapsed">0 ms</dd>
                    <dt>Throughput</dt>
                    <dd id="load-demonstration-throughput">0 decisions/s</dd>
                </dl>
                <h3>Decision latency histogram</h3>
                <ul id="load-demonstration-histogram" class="load-demonstration-histogram">
                    <li>No decisions observed.</li>
                </ul>
            </div>
        }

        @if (Model.ShowPolicySimulator)
        {
            <div id="explorer-output-simulator" class="explorer-output" data-output-view="simulator" hidden>
                <h2>Simulation result</h2>
                <p id="policy-simulator-empty" class="output-note">
                    Evaluate a request in the Policy simulator tab to see each stage of its decision.
                </p>
                <div id="policy-simulator-result" class="policy-simulator-result" aria-live="polite"></div>
            </div>
        }

        @if (Model.ShowDecisionReplay)
        {
            <div id="explorer-output-replay" class="explorer-output" data-output-view="replay" hidden>
                <h2>Decision replay</h2>
                <p id="decision-replay-empty" class="output-note">
                    Find or select a decision in the Decision replay tab to see what the ledger can reconstruct.
                </p>
                <div id="decision-replay-details" class="decision-replay-details" aria-live="polite"></div>
                <div id="decision-replay-result" class="decision-replay-result" aria-live="polite"></div>
            </div>
        }

        @if (Model.ShowPipelineInspector)
        {
            <div id="explorer-output-pipeline" class="explorer-output" data-output-view="pipeline" hidden>
                <p class="demonstration-label">Demonstration, not a benchmark</p>
                <h2>Governance pipeline</h2>
                <section class="pipeline-section" aria-labelledby="pipeline-stages-heading">
                    <h3 id="pipeline-stages-heading">Stage timing</h3>
                    <div id="pipeline-stages">
                        <p class="output-note">Run a governed action, or enter a correlation identifier, to time its stages.</p>
                    </div>
                </section>
                <section class="pipeline-section" aria-labelledby="pipeline-outbox-heading">
                    <h3 id="pipeline-outbox-heading">Audit-completion outbox</h3>
                    <div id="pipeline-outbox"></div>
                </section>
                <section class="pipeline-section" aria-labelledby="pipeline-reconciliation-heading">
                    <h3 id="pipeline-reconciliation-heading">Reconciliation</h3>
                    <div id="pipeline-reconciliation"></div>
                </section>
                <section class="pipeline-section" aria-labelledby="pipeline-telemetry-heading">
                    <h3 id="pipeline-telemetry-heading">Telemetry</h3>
                    <div id="pipeline-telemetry"></div>
                </section>
            </div>
        }

        @if (Model.ShowFailureScenarios)
        {
            <div id="explorer-output-scenarios" class="explorer-output" data-output-view="scenarios" hidden>
                <h2>Scenario result</h2>
                <p id="failure-scenario-empty" class="output-note">
                    Run a scenario in the Failure scenarios tab to see its outcome and the evidence it left behind.
                </p>
                <div id="failure-scenario-result" class="failure-scenario-result" aria-live="polite"></div>
            </div>
        }
    </section>
</div>

@section Scripts {
    <script src="~/js/governance-explorer.js" asp-append-version="true" defer></script>
}
